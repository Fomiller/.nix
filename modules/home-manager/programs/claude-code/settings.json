{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-5-5",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/dev/personal/.nix/modules/home-manager/programs/claude-code/mods/pr-organizer:~/dev/personal/.nix/modules/home-manager/programs/claude-code/mods/linear-viewer:~/dev/personal/.nix/modules/home-manager/programs/claude-code/mods/jira-viewer"
  },
  "pluginConfigs": {
    "pr-organizer": {
      "options": {
        "alerts": "band"
      }
    }
  },
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.incident.io/*"
    }
  ],
  "permissions": {
    "allow": [
      "mcp__incident_io__*",
      "Skill(incident)"
    ],
    "additionalDirectories": [
      "/Users/forrest.miller/dev/worktrees",
      "/Users/forrest/dev/worktrees"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/forrest.miller/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "claude-statusline"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "cloudflare@cloudflare": true,
    "flox@flox-skills": true,
    "github@claude-plugins-official": false,
    "gopls-lsp@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "superpowers@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "worktrunk@worktrunk": true,
    "incident-io@claude-plugins-official": true,
    "skins@hellosverre-mods": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "flox-skills": {
      "source": {
        "source": "github",
        "repo": "flox/flox-skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    }
  },
  "outputStyle": "ELI5",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
